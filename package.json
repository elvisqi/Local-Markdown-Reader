{
  "name": "local-markdown-reader",
  "version": "2.3.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "themes:obsidian-css": "node scripts/build-obsidian-theme-css.mjs",
    "themes:previews": "node scripts/build-theme-previews.mjs",
    "themes:official": "node scripts/build-official-themes.mjs && node scripts/build-theme-index.mjs",
    "themes:official:verify": "node scripts/verify-official-themes.mjs",
    "themes:visual": "node scripts/capture-theme-preview-screenshots.mjs",
    "themes:index": "node scripts/build-theme-index.mjs",
    "themes:verify": "node scripts/build-theme-index.mjs --check && node scripts/verify-official-themes.mjs",
    "themes:references:verify": "node scripts/verify-theme-references.mjs",
    "preflight": "npm run themes:verify && npm run themes:references:verify && npm run typecheck && npm test -- --run && npm run build && npm run verify:dist",
    "verify:dist": "node scripts/verify-dist.mjs",
    "test": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@vitejs/plugin-react": "^6.0.1",
    "css-tree": "^3.2.1",
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.6",
    "react-arborist": "^3.8.0",
    "react-dom": "^19.2.6",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vanilla-jsoneditor": "^3.12.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "chrome-types": "^0.1.426",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  }
}
