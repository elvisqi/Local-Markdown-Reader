{
  "id": "sanctum-archive",
  "name": "Sanctum Archive",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Paper archive theme inspired by Sanctum and Notation.",
  "minAppVersion": "2.3.1",
  "colorScheme": "system",
  "tokens": {
    "--markdown-font-size": "17px",
    "--markdown-line-height": "1.82",
    "--reader-radius": "6px",
    "--reader-heading-font": "Georgia, \"Times New Roman\", serif",
    "--reader-file-tree-row-height": "24px",
    "--reader-toolbar-height": "50px",
    "--reader-table-cell-padding": "9px 12px",
    "--reader-code-radius": "6px",
    "--reader-callout-radius": "6px",
    "--reader-tag-radius": "999px",
    "--reader-h1-size": "31px",
    "--reader-h2-size": "23px",
    "--reader-h3-size": "19px",
    "--reader-paragraph-spacing": "15px"
  },
  "lightTokens": {
    "--reader-page-bg": "#f5efe4",
    "--reader-surface": "#fffaf0",
    "--reader-border": "#d8cbb5",
    "--reader-text": "#332b22",
    "--reader-muted": "#7d7163",
    "--reader-link": "#8a5f2c",
    "--reader-panel-bg": "#fbf3e6",
    "--reader-panel-border": "#d8cbb5",
    "--reader-accent": "#a06a2d",
    "--reader-accent-muted": "#f4e6d1",
    "--reader-selection-bg": "#f4e6d1",
    "--reader-heading-text": "#332b22",
    "--reader-heading-border": "#d8cbb5",
    "--reader-code-bg": "#f1e6d6",
    "--reader-code-text": "#332b22",
    "--reader-inline-code-bg": "#f1e6d6",
    "--reader-inline-code-text": "#332b22",
    "--reader-table-head": "#f3e7d5",
    "--reader-table-stripe": "#fcf5ea",
    "--reader-table-text": "#332b22",
    "--reader-table-border": "#d8cbb5",
    "--reader-table-row-hover": "#f4e6d1",
    "--reader-rule": "#d8cbb5",
    "--reader-quote-bg": "#f6ead8",
    "--reader-quote-border": "#a06a2d",
    "--reader-quote-text": "#332b22",
    "--reader-callout-bg": "#f6ead8",
    "--reader-callout-border": "#d8cbb5",
    "--reader-callout-title": "#332b22",
    "--reader-callout-text": "#332b22",
    "--reader-task-done": "#7d7163",
    "--reader-checkbox-bg": "#fffaf0",
    "--reader-checkbox-border": "#d8cbb5",
    "--reader-checkbox-checked-bg": "#a06a2d",
    "--reader-checkbox-check-color": "#fffaf0",
    "--reader-mark-bg": "#ffe08a",
    "--reader-mark-text": "#332b22",
    "--reader-tag-bg": "#f4e6d1",
    "--reader-tag-text": "#a06a2d",
    "--reader-base-00": "#fffaf0",
    "--reader-base-10": "#fbf3e6",
    "--reader-base-20": "#f1e6d6",
    "--reader-base-30": "#d8cbb5",
    "--reader-base-50": "#7d7163",
    "--reader-base-70": "#7d7163",
    "--reader-base-100": "#332b22",
    "--reader-color-red": "#d14d4d",
    "--reader-color-orange": "#d4823b",
    "--reader-color-yellow": "#c29a25",
    "--reader-color-green": "#5f9f67",
    "--reader-color-cyan": "#21a6b8",
    "--reader-color-blue": "#8a5f2c",
    "--reader-color-purple": "#8b6fd1",
    "--reader-color-pink": "#c75b9b",
    "--reader-toolbar-bg": "#fbf3e6",
    "--reader-control-bg": "#fffaf0",
    "--reader-tree-row-hover": "#f4e6d1",
    "--reader-tree-row-active": "#f4e6d1",
    "--reader-outline-active-bg": "#f4e6d1",
    "--reader-syntax-keyword": "#8b6fd1",
    "--reader-syntax-string": "#5f9f67",
    "--reader-syntax-function": "#8a5f2c",
    "--reader-syntax-comment": "#7d7163",
    "--reader-shadow": "0 14px 34px rgba(51, 43, 34, 0.08)"
  },
  "darkTokens": {
    "--reader-page-bg": "#17120d",
    "--reader-surface": "#211a14",
    "--reader-border": "#403427",
    "--reader-text": "#efe1ce",
    "--reader-muted": "#b09d85",
    "--reader-link": "#e2b16f",
    "--reader-panel-bg": "#1c160f",
    "--reader-panel-border": "#403427",
    "--reader-accent": "#d59950",
    "--reader-accent-muted": "#332718",
    "--reader-selection-bg": "#332718",
    "--reader-heading-text": "#efe1ce",
    "--reader-heading-border": "#403427",
    "--reader-code-bg": "#2b2118",
    "--reader-code-text": "#efe1ce",
    "--reader-inline-code-bg": "#2b2118",
    "--reader-inline-code-text": "#efe1ce",
    "--reader-table-head": "#2c2118",
    "--reader-table-stripe": "#241b14",
    "--reader-table-text": "#efe1ce",
    "--reader-table-border": "#403427",
    "--reader-table-row-hover": "#332718",
    "--reader-rule": "#403427",
    "--reader-quote-bg": "#2b2118",
    "--reader-quote-border": "#d59950",
    "--reader-quote-text": "#efe1ce",
    "--reader-callout-bg": "#2b2118",
    "--reader-callout-border": "#403427",
    "--reader-callout-title": "#efe1ce",
    "--reader-callout-text": "#efe1ce",
    "--reader-task-done": "#b09d85",
    "--reader-checkbox-bg": "#211a14",
    "--reader-checkbox-border": "#403427",
    "--reader-checkbox-checked-bg": "#d59950",
    "--reader-checkbox-check-color": "#211a14",
    "--reader-mark-bg": "#60491e",
    "--reader-mark-text": "#efe1ce",
    "--reader-tag-bg": "#332718",
    "--reader-tag-text": "#d59950",
    "--reader-base-00": "#211a14",
    "--reader-base-10": "#1c160f",
    "--reader-base-20": "#2b2118",
    "--reader-base-30": "#403427",
    "--reader-base-50": "#b09d85",
    "--reader-base-70": "#b09d85",
    "--reader-base-100": "#efe1ce",
    "--reader-color-red": "#d14d4d",
    "--reader-color-orange": "#d4823b",
    "--reader-color-yellow": "#c29a25",
    "--reader-color-green": "#5f9f67",
    "--reader-color-cyan": "#21a6b8",
    "--reader-color-blue": "#e2b16f",
    "--reader-color-purple": "#8b6fd1",
    "--reader-color-pink": "#c75b9b",
    "--reader-toolbar-bg": "#1c160f",
    "--reader-control-bg": "#211a14",
    "--reader-tree-row-hover": "#332718",
    "--reader-tree-row-active": "#332718",
    "--reader-outline-active-bg": "#332718",
    "--reader-syntax-keyword": "#8b6fd1",
    "--reader-syntax-string": "#5f9f67",
    "--reader-syntax-function": "#e2b16f",
    "--reader-syntax-comment": "#b09d85",
    "--reader-shadow": "0 14px 34px rgba(239, 225, 206, 0.08)"
  },
  "features": [
    "callouts",
    "tables",
    "code",
    "outline"
  ],
  "previewFixtures": [
    "longform",
    "note",
    "callouts"
  ],
  "css": ".document-reader { font-feature-settings: \"liga\" 1, \"calt\" 1; }\n.document-reader .markdown-heading { font-family: var(--reader-heading-font); color: var(--reader-heading-text); letter-spacing: 0; }\n.document-reader .markdown-heading--h1 { margin-bottom: 0.58em; }\n.document-reader .markdown-heading--h2 { margin-top: 1.35em; }\n.document-reader .markdown-paragraph { margin-bottom: var(--reader-paragraph-spacing); }\n.document-reader .markdown-link { text-decoration-thickness: 1px; text-underline-offset: 0.16em; }\n.document-reader .markdown-inline-code { padding: 0.1em 0.32em; border-radius: var(--reader-code-radius); }\n.document-reader .markdown-code-block { background: var(--reader-code-bg); color: var(--reader-code-text); border-radius: var(--reader-code-radius); }\n.document-reader .markdown-table { color: var(--reader-table-text); }\n.document-reader .markdown-table-cell { padding: var(--reader-table-cell-padding); }\n.document-reader .markdown-table-row:nth-child(even) .markdown-table-cell { background: var(--reader-table-stripe); }\n.document-reader .markdown-quote { background: var(--reader-quote-bg); color: var(--reader-quote-text); }\n.document-reader .callout { background: var(--reader-callout-bg); border-color: var(--reader-callout-border); }\n.document-reader .callout-title { color: var(--reader-callout-title); }\n.document-reader .markdown-tag { border-radius: var(--reader-tag-radius); padding: var(--reader-tag-padding); }\n[data-theme-layout-scope=\"toolbar-group\"] { min-height: var(--reader-toolbar-height); }\n[data-theme-layout-scope=\"outline-indicator\"].is-active { color: var(--reader-link); }\n[data-theme-layout-scope=\"table-actions\"] { color: var(--reader-muted); }\n[data-theme-layout-scope=\"mermaid-actions\"] { color: var(--reader-text); }\n@media (max-width: 700px) { .document-reader .markdown-heading--h1 { font-size: 26px; } }\n.document-reader .markdown-heading { font-family: var(--reader-heading-font); }\n.document-reader .markdown-quote { border-left-width: 3px; font-style: italic; }\n.document-reader .markdown-mark { border-radius: 2px; padding-inline: 0.15em; }\n.document-reader .markdown-rule { border-style: dashed; }\n[data-theme-layout-scope=\"outline-indicator\"].is-active { border-left: 3px double var(--reader-accent); }"
}
