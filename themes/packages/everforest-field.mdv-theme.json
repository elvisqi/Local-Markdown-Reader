{
  "id": "everforest-field",
  "name": "Everforest Field",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Muted green field-note theme inspired by Everforest and Gruvbox.",
  "minAppVersion": "2.3.1",
  "colorScheme": "system",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.76",
    "--reader-radius": "8px",
    "--reader-heading-font": "Georgia, \"Times New Roman\", serif",
    "--reader-file-tree-row-height": "26px",
    "--reader-toolbar-height": "52px",
    "--reader-table-cell-padding": "9px 12px",
    "--reader-code-radius": "8px",
    "--reader-callout-radius": "8px",
    "--reader-tag-radius": "999px",
    "--reader-h1-size": "31px",
    "--reader-h2-size": "23px",
    "--reader-h3-size": "19px",
    "--reader-paragraph-spacing": "13px"
  },
  "lightTokens": {
    "--reader-page-bg": "#f3f1e8",
    "--reader-surface": "#fffdf2",
    "--reader-border": "#d8d0b8",
    "--reader-text": "#2d3326",
    "--reader-muted": "#6f765f",
    "--reader-link": "#4f7a4c",
    "--reader-panel-bg": "#f8f4e8",
    "--reader-panel-border": "#d8d0b8",
    "--reader-accent": "#6d8f54",
    "--reader-accent-muted": "#e9f0dc",
    "--reader-selection-bg": "#e9f0dc",
    "--reader-heading-text": "#2d3326",
    "--reader-heading-border": "#d8d0b8",
    "--reader-code-bg": "#eee9d8",
    "--reader-code-text": "#2d3326",
    "--reader-inline-code-bg": "#eee9d8",
    "--reader-inline-code-text": "#2d3326",
    "--reader-table-head": "#ece6d2",
    "--reader-table-stripe": "#faf7ed",
    "--reader-table-text": "#2d3326",
    "--reader-table-border": "#d8d0b8",
    "--reader-table-row-hover": "#e9f0dc",
    "--reader-rule": "#d8d0b8",
    "--reader-quote-bg": "#eef2dd",
    "--reader-quote-border": "#6d8f54",
    "--reader-quote-text": "#2d3326",
    "--reader-callout-bg": "#eef2dd",
    "--reader-callout-border": "#d8d0b8",
    "--reader-callout-title": "#2d3326",
    "--reader-callout-text": "#2d3326",
    "--reader-task-done": "#6f765f",
    "--reader-checkbox-bg": "#fffdf2",
    "--reader-checkbox-border": "#d8d0b8",
    "--reader-checkbox-checked-bg": "#6d8f54",
    "--reader-checkbox-check-color": "#fffdf2",
    "--reader-mark-bg": "#f8dfa0",
    "--reader-mark-text": "#2d3326",
    "--reader-tag-bg": "#e9f0dc",
    "--reader-tag-text": "#6d8f54",
    "--reader-base-00": "#fffdf2",
    "--reader-base-10": "#f8f4e8",
    "--reader-base-20": "#eee9d8",
    "--reader-base-30": "#d8d0b8",
    "--reader-base-50": "#6f765f",
    "--reader-base-70": "#6f765f",
    "--reader-base-100": "#2d3326",
    "--reader-color-red": "#d14d4d",
    "--reader-color-orange": "#d4823b",
    "--reader-color-yellow": "#c29a25",
    "--reader-color-green": "#5f9f67",
    "--reader-color-cyan": "#21a6b8",
    "--reader-color-blue": "#4f7a4c",
    "--reader-color-purple": "#8b6fd1",
    "--reader-color-pink": "#c75b9b",
    "--reader-toolbar-bg": "#f8f4e8",
    "--reader-control-bg": "#fffdf2",
    "--reader-tree-row-hover": "#e9f0dc",
    "--reader-tree-row-active": "#e9f0dc",
    "--reader-outline-active-bg": "#e9f0dc",
    "--reader-syntax-keyword": "#8b6fd1",
    "--reader-syntax-string": "#5f9f67",
    "--reader-syntax-function": "#4f7a4c",
    "--reader-syntax-comment": "#6f765f",
    "--reader-shadow": "0 14px 34px rgba(45, 51, 38, 0.08)"
  },
  "darkTokens": {
    "--reader-page-bg": "#151711",
    "--reader-surface": "#1f2419",
    "--reader-border": "#3a432f",
    "--reader-text": "#e6dfc7",
    "--reader-muted": "#aaa282",
    "--reader-link": "#a7c080",
    "--reader-panel-bg": "#1a1f15",
    "--reader-panel-border": "#3a432f",
    "--reader-accent": "#a7c080",
    "--reader-accent-muted": "#28351f",
    "--reader-selection-bg": "#28351f",
    "--reader-heading-text": "#e6dfc7",
    "--reader-heading-border": "#3a432f",
    "--reader-code-bg": "#292d20",
    "--reader-code-text": "#e6dfc7",
    "--reader-inline-code-bg": "#292d20",
    "--reader-inline-code-text": "#e6dfc7",
    "--reader-table-head": "#2c3326",
    "--reader-table-stripe": "#23291e",
    "--reader-table-text": "#e6dfc7",
    "--reader-table-border": "#3a432f",
    "--reader-table-row-hover": "#28351f",
    "--reader-rule": "#3a432f",
    "--reader-quote-bg": "#25301f",
    "--reader-quote-border": "#a7c080",
    "--reader-quote-text": "#e6dfc7",
    "--reader-callout-bg": "#25301f",
    "--reader-callout-border": "#3a432f",
    "--reader-callout-title": "#e6dfc7",
    "--reader-callout-text": "#e6dfc7",
    "--reader-task-done": "#aaa282",
    "--reader-checkbox-bg": "#1f2419",
    "--reader-checkbox-border": "#3a432f",
    "--reader-checkbox-checked-bg": "#a7c080",
    "--reader-checkbox-check-color": "#1f2419",
    "--reader-mark-bg": "#5e4b1d",
    "--reader-mark-text": "#e6dfc7",
    "--reader-tag-bg": "#28351f",
    "--reader-tag-text": "#a7c080",
    "--reader-base-00": "#1f2419",
    "--reader-base-10": "#1a1f15",
    "--reader-base-20": "#292d20",
    "--reader-base-30": "#3a432f",
    "--reader-base-50": "#aaa282",
    "--reader-base-70": "#aaa282",
    "--reader-base-100": "#e6dfc7",
    "--reader-color-red": "#d14d4d",
    "--reader-color-orange": "#d4823b",
    "--reader-color-yellow": "#c29a25",
    "--reader-color-green": "#5f9f67",
    "--reader-color-cyan": "#21a6b8",
    "--reader-color-blue": "#a7c080",
    "--reader-color-purple": "#8b6fd1",
    "--reader-color-pink": "#c75b9b",
    "--reader-toolbar-bg": "#1a1f15",
    "--reader-control-bg": "#1f2419",
    "--reader-tree-row-hover": "#28351f",
    "--reader-tree-row-active": "#28351f",
    "--reader-outline-active-bg": "#28351f",
    "--reader-syntax-keyword": "#8b6fd1",
    "--reader-syntax-string": "#5f9f67",
    "--reader-syntax-function": "#a7c080",
    "--reader-syntax-comment": "#aaa282",
    "--reader-shadow": "0 14px 34px rgba(230, 223, 199, 0.08)"
  },
  "features": [
    "callouts",
    "tables",
    "code",
    "tasks",
    "outline"
  ],
  "previewFixtures": [
    "note",
    "tasks",
    "table"
  ],
  "css": ".document-reader { font-feature-settings: \"liga\" 1, \"calt\" 1; }\n.document-reader .markdown-heading { font-family: var(--reader-heading-font); color: var(--reader-heading-text); letter-spacing: 0; }\n.document-reader .markdown-heading--h1 { margin-bottom: 0.58em; }\n.document-reader .markdown-heading--h2 { margin-top: 1.35em; }\n.document-reader .markdown-paragraph { margin-bottom: var(--reader-paragraph-spacing); }\n.document-reader .markdown-link { text-decoration-thickness: 1px; text-underline-offset: 0.16em; }\n.document-reader .markdown-inline-code { padding: 0.1em 0.32em; border-radius: var(--reader-code-radius); }\n.document-reader .markdown-code-block { background: var(--reader-code-bg); color: var(--reader-code-text); border-radius: var(--reader-code-radius); }\n.document-reader .markdown-table { color: var(--reader-table-text); }\n.document-reader .markdown-table-cell { padding: var(--reader-table-cell-padding); }\n.document-reader .markdown-table-row:nth-child(even) .markdown-table-cell { background: var(--reader-table-stripe); }\n.document-reader .markdown-quote { background: var(--reader-quote-bg); color: var(--reader-quote-text); }\n.document-reader .callout { background: var(--reader-callout-bg); border-color: var(--reader-callout-border); }\n.document-reader .callout-title { color: var(--reader-callout-title); }\n.document-reader .markdown-tag { border-radius: var(--reader-tag-radius); padding: var(--reader-tag-padding); }\n[data-theme-layout-scope=\"toolbar-group\"] { min-height: var(--reader-toolbar-height); }\n[data-theme-layout-scope=\"outline-indicator\"].is-active { color: var(--reader-link); }\n[data-theme-layout-scope=\"table-actions\"] { color: var(--reader-muted); }\n[data-theme-layout-scope=\"mermaid-actions\"] { color: var(--reader-text); }\n@media (max-width: 700px) { .document-reader .markdown-heading--h1 { font-size: 26px; } }\n.document-reader .markdown-task { border-bottom: 1px solid color-mix(in srgb, var(--reader-border) 55%, transparent); }\n.document-reader .markdown-quote { background: var(--reader-quote-bg); }\n.document-reader .callout { border-left-width: 4px; }\n.document-reader .markdown-heading--h2 { border-bottom: 1px solid var(--reader-heading-border); }\n[data-theme-layout-scope=\"toolbar-group\"] button { border-radius: 8px; }"
}
