{
  "id": "pastel-puccin",
  "name": "Pastel Puccin",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "AnuPpuccin inspired pastel dark theme with soft lavender accents.",
  "minAppVersion": "2.3.1",
  "colorScheme": "dark",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.76",
    "--reader-page-bg": "#1d1a24",
    "--reader-surface": "#272331",
    "--reader-border": "#40394d",
    "--reader-text": "#eee8f4",
    "--reader-muted": "#b8aec5",
    "--reader-link": "#c7a5ff",
    "--reader-radius": "10px",
    "--reader-panel-bg": "#211e2a",
    "--reader-panel-border": "#40394d",
    "--reader-accent": "#c7a5ff",
    "--reader-accent-muted": "#392c4f",
    "--reader-selection-bg": "#4a3a64",
    "--reader-heading-text": "#ffd5ea",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#4a4058",
    "--reader-code-bg": "#302b3b",
    "--reader-code-text": "#f0e6ff",
    "--reader-inline-code-bg": "#332d40",
    "--reader-inline-code-text": "#ffd5ea",
    "--reader-table-head": "#302b3b",
    "--reader-table-stripe": "#292433",
    "--reader-rule": "#4a4058",
    "--reader-quote-bg": "#2b2636",
    "--reader-quote-border": "#f2a6c8",
    "--reader-quote-text": "#dccfe8",
    "--reader-task-done": "#8f839c",
    "--reader-mark-bg": "#5d452d",
    "--reader-mark-text": "#ffe7b8",
    "--reader-tag-bg": "#392c4f",
    "--reader-tag-text": "#dbc8ff",
    "--reader-shadow": "0 20px 48px rgba(0, 0, 0, 0.28)"
  },
  "css": ".document-reader blockquote { border-radius: 8px; padding: 10px 14px; } .document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 730; }"
}
