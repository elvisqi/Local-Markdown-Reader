{
  "id": "pastel-puccin",
  "name": "Pastel Puccin",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "AnuPpuccin inspired pastel dark theme with soft lavender accents.",
  "minAppVersion": "2.3.1",
  "colorScheme": "dark",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.76",
    "--reader-page-bg": "#1d1a24",
    "--reader-surface": "#272331",
    "--reader-border": "#40394d",
    "--reader-text": "#eee8f4",
    "--reader-muted": "#b8aec5",
    "--reader-link": "#c7a5ff",
    "--reader-radius": "10px",
    "--reader-panel-bg": "#211e2a",
    "--reader-panel-border": "#40394d",
    "--reader-accent": "#c7a5ff",
    "--reader-accent-muted": "#392c4f",
    "--reader-selection-bg": "#4a3a64",
    "--reader-heading-text": "#ffd5ea",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#4a4058",
    "--reader-code-bg": "#302b3b",
    "--reader-code-text": "#f0e6ff",
    "--reader-inline-code-bg": "#332d40",
    "--reader-inline-code-text": "#ffd5ea",
    "--reader-table-head": "#302b3b",
    "--reader-table-stripe": "#292433",
    "--reader-rule": "#4a4058",
    "--reader-quote-bg": "#2b2636",
    "--reader-quote-border": "#f2a6c8",
    "--reader-quote-text": "#dccfe8",
    "--reader-task-done": "#8f839c",
    "--reader-mark-bg": "#5d452d",
    "--reader-mark-text": "#ffe7b8",
    "--reader-tag-bg": "#392c4f",
    "--reader-tag-text": "#dbc8ff",
    "--reader-shadow": "0 20px 48px rgba(0, 0, 0, 0.28)",
    "--reader-font-family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#ffd5ea",
    "--reader-h1-size": "29px",
    "--reader-h1-weight": "740",
    "--reader-h2-color": "#dbc8ff",
    "--reader-h2-size": "23px",
    "--reader-h2-weight": "720",
    "--reader-h3-color": "#c7a5ff",
    "--reader-h3-size": "18px",
    "--reader-h3-weight": "700",
    "--reader-paragraph-spacing": "15px",
    "--reader-list-spacing": "16px",
    "--reader-list-indent": "25px",
    "--reader-table-text": "#eee8f4",
    "--reader-table-border": "#40394d",
    "--reader-table-cell-padding": "9px 12px",
    "--reader-table-row-hover": "#342d43",
    "--reader-code-radius": "8px",
    "--reader-code-border": "#40394d",
    "--reader-code-font-size": "0.88em",
    "--reader-quote-padding": "10px 14px",
    "--reader-quote-radius": "8px",
    "--reader-callout-bg": "#2b2636",
    "--reader-callout-border": "#f2a6c8",
    "--reader-callout-title": "#ffd5ea",
    "--reader-callout-text": "#dccfe8",
    "--reader-callout-radius": "10px",
    "--reader-checkbox-bg": "#272331",
    "--reader-checkbox-border": "#756681",
    "--reader-checkbox-checked-bg": "#c7a5ff",
    "--reader-checkbox-check-color": "#1d1a24",
    "--reader-tag-radius": "999px",
    "--reader-tag-padding": "0.08em 0.55em",
    "--reader-base-00": "#1d1a24",
    "--reader-base-10": "#272331",
    "--reader-base-20": "#302b3b",
    "--reader-base-30": "#40394d",
    "--reader-base-50": "#8f839c",
    "--reader-base-70": "#dccfe8",
    "--reader-base-100": "#eee8f4",
    "--reader-color-blue": "#8fb7ff",
    "--reader-color-purple": "#c7a5ff",
    "--reader-toolbar-bg": "#211e2a",
    "--reader-control-bg": "#272331",
    "--reader-control-radius": "10px",
    "--reader-tree-row-hover": "#302b3b",
    "--reader-tree-row-active": "#392c4f",
    "--reader-outline-active-bg": "#392c4f",
    "--reader-syntax-keyword": "#c7a5ff",
    "--reader-syntax-string": "#a6e3a1",
    "--reader-syntax-function": "#89b4fa",
    "--reader-syntax-comment": "#b8aec5"
  },
  "css": ".document-reader blockquote { border-radius: 8px; padding: 10px 14px; } .document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 730; }"
}
