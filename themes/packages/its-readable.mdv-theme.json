{
  "id": "its-readable",
  "name": "ITS Readable",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Readable system theme for long reference documents and dense tables.",
  "minAppVersion": "2.3.1",
  "colorScheme": "system",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.74",
    "--reader-page-bg": "#f3f5f7",
    "--reader-surface": "#ffffff",
    "--reader-border": "#d7dee7",
    "--reader-text": "#202832",
    "--reader-muted": "#657282",
    "--reader-link": "#27658f",
    "--reader-radius": "7px",
    "--reader-panel-bg": "#fbfcfd",
    "--reader-panel-border": "#d7dee7",
    "--reader-accent": "#27658f",
    "--reader-accent-muted": "#e4f0f4",
    "--reader-selection-bg": "#cfe6ee",
    "--reader-heading-text": "#15202b",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#ccd6e0",
    "--reader-code-bg": "#eef3f6",
    "--reader-code-text": "#243342",
    "--reader-inline-code-bg": "#eaf1f4",
    "--reader-inline-code-text": "#204860",
    "--reader-table-head": "#e9eef3",
    "--reader-table-stripe": "#f7f9fb",
    "--reader-rule": "#d1d9e3",
    "--reader-quote-bg": "#f2f7f8",
    "--reader-quote-border": "#78a6b7",
    "--reader-quote-text": "#50606d",
    "--reader-task-done": "#798696",
    "--reader-mark-bg": "#fff2a8",
    "--reader-mark-text": "#202832",
    "--reader-tag-bg": "#e4f0f4",
    "--reader-tag-text": "#27658f",
    "--reader-shadow": "0 14px 34px rgba(32, 40, 50, 0.08)"
  },
  "css": ".document-reader table { font-variant-numeric: tabular-nums; } .document-reader th, .document-reader td { padding-top: 0.5em; padding-bottom: 0.5em; }"
}
