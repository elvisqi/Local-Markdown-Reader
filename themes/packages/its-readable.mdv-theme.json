{
  "id": "its-readable",
  "name": "ITS Readable",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Readable system theme for long reference documents and dense tables.",
  "minAppVersion": "2.3.1",
  "colorScheme": "system",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.74",
    "--reader-page-bg": "#f3f5f7",
    "--reader-surface": "#ffffff",
    "--reader-border": "#d7dee7",
    "--reader-text": "#202832",
    "--reader-muted": "#657282",
    "--reader-link": "#27658f",
    "--reader-radius": "7px",
    "--reader-panel-bg": "#fbfcfd",
    "--reader-panel-border": "#d7dee7",
    "--reader-accent": "#27658f",
    "--reader-accent-muted": "#e4f0f4",
    "--reader-selection-bg": "#cfe6ee",
    "--reader-heading-text": "#15202b",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#ccd6e0",
    "--reader-code-bg": "#eef3f6",
    "--reader-code-text": "#243342",
    "--reader-inline-code-bg": "#eaf1f4",
    "--reader-inline-code-text": "#204860",
    "--reader-table-head": "#e9eef3",
    "--reader-table-stripe": "#f7f9fb",
    "--reader-rule": "#d1d9e3",
    "--reader-quote-bg": "#f2f7f8",
    "--reader-quote-border": "#78a6b7",
    "--reader-quote-text": "#50606d",
    "--reader-task-done": "#798696",
    "--reader-mark-bg": "#fff2a8",
    "--reader-mark-text": "#202832",
    "--reader-tag-bg": "#e4f0f4",
    "--reader-tag-text": "#27658f",
    "--reader-shadow": "0 14px 34px rgba(32, 40, 50, 0.08)",
    "--reader-font-family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#15202b",
    "--reader-h1-size": "30px",
    "--reader-h1-weight": "760",
    "--reader-h2-color": "#1f3442",
    "--reader-h2-size": "23px",
    "--reader-h2-weight": "720",
    "--reader-h3-color": "#27658f",
    "--reader-h3-size": "18px",
    "--reader-h3-weight": "690",
    "--reader-paragraph-spacing": "14px",
    "--reader-list-spacing": "16px",
    "--reader-list-indent": "25px",
    "--reader-table-text": "#202832",
    "--reader-table-border": "#ccd6e0",
    "--reader-table-cell-padding": "8px 10px",
    "--reader-table-row-hover": "#edf5f7",
    "--reader-code-radius": "6px",
    "--reader-code-border": "#d7dee7",
    "--reader-code-font-size": "0.87em",
    "--reader-quote-padding": "8px 14px",
    "--reader-quote-radius": "6px",
    "--reader-callout-bg": "#f2f7f8",
    "--reader-callout-border": "#78a6b7",
    "--reader-callout-title": "#27658f",
    "--reader-callout-text": "#50606d",
    "--reader-callout-radius": "7px",
    "--reader-checkbox-bg": "#ffffff",
    "--reader-checkbox-border": "#8aa6b3",
    "--reader-checkbox-checked-bg": "#27658f",
    "--reader-checkbox-check-color": "#ffffff",
    "--reader-tag-radius": "6px",
    "--reader-tag-padding": "0.06em 0.5em",
    "--reader-base-00": "#ffffff",
    "--reader-base-10": "#fbfcfd",
    "--reader-base-20": "#eef3f6",
    "--reader-base-30": "#d7dee7",
    "--reader-base-50": "#8795a7",
    "--reader-base-70": "#50606d",
    "--reader-base-100": "#202832",
    "--reader-color-blue": "#27658f",
    "--reader-color-purple": "#6b61b1",
    "--reader-toolbar-bg": "#fbfcfd",
    "--reader-control-bg": "#ffffff",
    "--reader-control-radius": "7px",
    "--reader-tree-row-hover": "#edf5f7",
    "--reader-tree-row-active": "#e4f0f4",
    "--reader-outline-active-bg": "#e4f0f4",
    "--reader-syntax-keyword": "#6b61b1",
    "--reader-syntax-string": "#2f7d55",
    "--reader-syntax-function": "#27658f",
    "--reader-syntax-comment": "#657282"
  },
  "css": ".document-reader table { font-variant-numeric: tabular-nums; } .document-reader th, .document-reader td { padding-top: 0.5em; padding-bottom: 0.5em; }"
}
