{
  "id": "midnight-prose",
  "name": "Midnight Prose",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Low-fatigue dark theme tuned for long-form reading.",
  "minAppVersion": "2.3.1",
  "colorScheme": "dark",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.78",
    "--reader-page-bg": "#11161d",
    "--reader-surface": "#18212b",
    "--reader-border": "#2c3744",
    "--reader-text": "#e6ebf0",
    "--reader-muted": "#9aa7b5",
    "--reader-link": "#9ec0ff",
    "--reader-code-bg": "#202a35",
    "--reader-code-text": "#eef2f6",
    "--reader-table-head": "#202b37",
    "--reader-table-stripe": "#1b2530",
    "--reader-rule": "#33404f",
    "--reader-quote-bg": "#1b2632",
    "--reader-quote-border": "#5b6e84",
    "--reader-quote-text": "#c3ccd6",
    "--reader-shadow": "0 18px 38px rgba(0, 0, 0, 0.3)"
  },
  "css": ".document-reader h1, .document-reader h2, .document-reader h3 { color: var(--reader-text); letter-spacing: 0; } .document-reader strong { color: #f5f8fb; }"
}
