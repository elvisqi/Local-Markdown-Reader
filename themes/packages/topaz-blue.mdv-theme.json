{
  "id": "topaz-blue",
  "name": "Topaz Blue",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Blue Topaz inspired airy theme with saturated blue headings.",
  "minAppVersion": "2.3.1",
  "colorScheme": "light",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.74",
    "--reader-page-bg": "#eef6fb",
    "--reader-surface": "#fbfdff",
    "--reader-border": "#c8ddea",
    "--reader-text": "#1c2e3a",
    "--reader-muted": "#5f7180",
    "--reader-link": "#1b78a6",
    "--reader-radius": "10px",
    "--reader-panel-bg": "#f7fbfe",
    "--reader-panel-border": "#c8ddea",
    "--reader-accent": "#1b78a6",
    "--reader-accent-muted": "#dff0f8",
    "--reader-selection-bg": "#cfe8f6",
    "--reader-heading-text": "#116083",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#b9d6e6",
    "--reader-code-bg": "#e9f3f8",
    "--reader-code-text": "#244253",
    "--reader-inline-code-bg": "#e4f0f6",
    "--reader-inline-code-text": "#116083",
    "--reader-table-head": "#e2f1f8",
    "--reader-table-stripe": "#f3f9fc",
    "--reader-rule": "#b9d6e6",
    "--reader-quote-bg": "#eef8fc",
    "--reader-quote-border": "#62a7c5",
    "--reader-quote-text": "#4e6472",
    "--reader-task-done": "#7f8d96",
    "--reader-mark-bg": "#fff2a8",
    "--reader-mark-text": "#1c2e3a",
    "--reader-tag-bg": "#dff0f8",
    "--reader-tag-text": "#116083",
    "--reader-shadow": "0 18px 42px rgba(28, 46, 58, 0.08)",
    "--reader-font-family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#116083",
    "--reader-h1-size": "31px",
    "--reader-h1-weight": "780",
    "--reader-h2-color": "#176f98",
    "--reader-h2-size": "24px",
    "--reader-h2-weight": "740",
    "--reader-h3-color": "#1b78a6",
    "--reader-h3-size": "19px",
    "--reader-h3-weight": "700",
    "--reader-paragraph-spacing": "14px",
    "--reader-list-spacing": "16px",
    "--reader-list-indent": "25px",
    "--reader-table-text": "#1c2e3a",
    "--reader-table-border": "#b9d6e6",
    "--reader-table-cell-padding": "10px 12px",
    "--reader-table-row-hover": "#e8f5fb",
    "--reader-code-radius": "8px",
    "--reader-code-border": "#c8ddea",
    "--reader-code-font-size": "0.88em",
    "--reader-quote-padding": "9px 14px",
    "--reader-quote-radius": "0 8px 8px 0",
    "--reader-callout-bg": "#eef8fc",
    "--reader-callout-border": "#62a7c5",
    "--reader-callout-title": "#116083",
    "--reader-callout-text": "#4e6472",
    "--reader-callout-radius": "10px",
    "--reader-checkbox-bg": "#fbfdff",
    "--reader-checkbox-border": "#72adca",
    "--reader-checkbox-checked-bg": "#1b78a6",
    "--reader-checkbox-check-color": "#ffffff",
    "--reader-tag-radius": "999px",
    "--reader-tag-padding": "0.08em 0.55em",
    "--reader-base-00": "#fbfdff",
    "--reader-base-10": "#f7fbfe",
    "--reader-base-20": "#e9f3f8",
    "--reader-base-30": "#c8ddea",
    "--reader-base-50": "#72adca",
    "--reader-base-70": "#4e6472",
    "--reader-base-100": "#1c2e3a",
    "--reader-color-blue": "#1b78a6",
    "--reader-color-purple": "#6d5fd2",
    "--reader-toolbar-bg": "#f7fbfe",
    "--reader-control-bg": "#fbfdff",
    "--reader-control-radius": "10px",
    "--reader-tree-row-hover": "#e8f5fb",
    "--reader-tree-row-active": "#dff0f8",
    "--reader-outline-active-bg": "#dff0f8",
    "--reader-syntax-keyword": "#6d5fd2",
    "--reader-syntax-string": "#16845f",
    "--reader-syntax-function": "#1b78a6",
    "--reader-syntax-comment": "#5f7180"
  },
  "css": ".document-reader h1, .document-reader h2 { font-weight: 760; } .document-reader blockquote { border-radius: 0 8px 8px 0; }"
}
