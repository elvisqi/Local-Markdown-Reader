{
  "id": "paper-note",
  "name": "Paper Note",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Warm light paper style for essays, notes, and knowledge bases.",
  "minAppVersion": "2.3.1",
  "colorScheme": "light",
  "tokens": {
    "--markdown-font-size": "17px",
    "--markdown-line-height": "1.76",
    "--reader-page-bg": "#f5f2eb",
    "--reader-surface": "#fffaf1",
    "--reader-border": "#ded3bf",
    "--reader-text": "#2c271f",
    "--reader-muted": "#736655",
    "--reader-link": "#7a5b2a",
    "--reader-code-bg": "#f0eadf",
    "--reader-code-text": "#352f27",
    "--reader-table-head": "#f3eadb",
    "--reader-table-stripe": "#fff6e8",
    "--reader-rule": "#dccfb8",
    "--reader-quote-bg": "#f7efdf",
    "--reader-quote-border": "#b89a63",
    "--reader-quote-text": "#665744",
    "--reader-shadow": "0 14px 34px rgba(54, 45, 32, 0.09)"
  },
  "css": ".document-reader h1, .document-reader h2, .document-reader h3 { font-family: Georgia, Times, serif; letter-spacing: 0; } .document-reader blockquote { font-style: normal; }"
}
