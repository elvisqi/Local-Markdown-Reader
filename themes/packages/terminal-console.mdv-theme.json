{
  "id": "terminal-console",
  "name": "Terminal Console",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Command-line reading surface inspired by Cybertron, Dracula, and popular terminal themes.",
  "minAppVersion": "2.3.1",
  "colorScheme": "system",
  "tokens": {
    "--markdown-font-size": "15px",
    "--markdown-line-height": "1.66",
    "--reader-radius": "2px",
    "--reader-heading-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-file-tree-row-height": "22px",
    "--reader-toolbar-height": "46px",
    "--reader-table-cell-padding": "9px 12px",
    "--reader-code-radius": "2px",
    "--reader-callout-radius": "2px",
    "--reader-tag-radius": "4px",
    "--reader-h1-size": "30px",
    "--reader-h2-size": "23px",
    "--reader-h3-size": "19px",
    "--reader-paragraph-spacing": "13px"
  },
  "lightTokens": {
    "--reader-page-bg": "#f3f5f5",
    "--reader-surface": "#fbfcfc",
    "--reader-border": "#cfd8d8",
    "--reader-text": "#1d2929",
    "--reader-muted": "#5d6e6e",
    "--reader-link": "#0f6c7b",
    "--reader-panel-bg": "#eef2f2",
    "--reader-panel-border": "#cfd8d8",
    "--reader-accent": "#008c99",
    "--reader-accent-muted": "#d9f4f6",
    "--reader-selection-bg": "#d9f4f6",
    "--reader-heading-text": "#1d2929",
    "--reader-heading-border": "#cfd8d8",
    "--reader-code-bg": "#e9eeee",
    "--reader-code-text": "#1d2929",
    "--reader-inline-code-bg": "#e9eeee",
    "--reader-inline-code-text": "#1d2929",
    "--reader-table-head": "#e7eeee",
    "--reader-table-stripe": "#f6fafa",
    "--reader-table-text": "#1d2929",
    "--reader-table-border": "#cfd8d8",
    "--reader-table-row-hover": "#d9f4f6",
    "--reader-rule": "#cfd8d8",
    "--reader-quote-bg": "#edf6f7",
    "--reader-quote-border": "#008c99",
    "--reader-quote-text": "#1d2929",
    "--reader-callout-bg": "#edf6f7",
    "--reader-callout-border": "#cfd8d8",
    "--reader-callout-title": "#1d2929",
    "--reader-callout-text": "#1d2929",
    "--reader-task-done": "#5d6e6e",
    "--reader-checkbox-bg": "#fbfcfc",
    "--reader-checkbox-border": "#cfd8d8",
    "--reader-checkbox-checked-bg": "#008c99",
    "--reader-checkbox-check-color": "#fbfcfc",
    "--reader-mark-bg": "#fff0a6",
    "--reader-mark-text": "#1d2929",
    "--reader-tag-bg": "#d9f4f6",
    "--reader-tag-text": "#008c99",
    "--reader-base-00": "#fbfcfc",
    "--reader-base-10": "#eef2f2",
    "--reader-base-20": "#e9eeee",
    "--reader-base-30": "#cfd8d8",
    "--reader-base-50": "#5d6e6e",
    "--reader-base-70": "#5d6e6e",
    "--reader-base-100": "#1d2929",
    "--reader-color-red": "#d14d4d",
    "--reader-color-orange": "#d4823b",
    "--reader-color-yellow": "#c29a25",
    "--reader-color-green": "#5f9f67",
    "--reader-color-cyan": "#21a6b8",
    "--reader-color-blue": "#0f6c7b",
    "--reader-color-purple": "#8b6fd1",
    "--reader-color-pink": "#c75b9b",
    "--reader-toolbar-bg": "#eef2f2",
    "--reader-control-bg": "#fbfcfc",
    "--reader-tree-row-hover": "#d9f4f6",
    "--reader-tree-row-active": "#d9f4f6",
    "--reader-outline-active-bg": "#d9f4f6",
    "--reader-syntax-keyword": "#8b6fd1",
    "--reader-syntax-string": "#5f9f67",
    "--reader-syntax-function": "#0f6c7b",
    "--reader-syntax-comment": "#5d6e6e",
    "--reader-shadow": "0 14px 34px rgba(29, 41, 41, 0.08)"
  },
  "darkTokens": {
    "--reader-page-bg": "#090d10",
    "--reader-surface": "#101820",
    "--reader-border": "#25333d",
    "--reader-text": "#dff6ee",
    "--reader-muted": "#8fa8a4",
    "--reader-link": "#6ee7ff",
    "--reader-panel-bg": "#0c1218",
    "--reader-panel-border": "#25333d",
    "--reader-accent": "#00e0c6",
    "--reader-accent-muted": "#0d302e",
    "--reader-selection-bg": "#0d302e",
    "--reader-heading-text": "#dff6ee",
    "--reader-heading-border": "#25333d",
    "--reader-code-bg": "#142027",
    "--reader-code-text": "#dff6ee",
    "--reader-inline-code-bg": "#142027",
    "--reader-inline-code-text": "#dff6ee",
    "--reader-table-head": "#17242d",
    "--reader-table-stripe": "#111b22",
    "--reader-table-text": "#dff6ee",
    "--reader-table-border": "#25333d",
    "--reader-table-row-hover": "#0d302e",
    "--reader-rule": "#25333d",
    "--reader-quote-bg": "#10262a",
    "--reader-quote-border": "#00e0c6",
    "--reader-quote-text": "#dff6ee",
    "--reader-callout-bg": "#10262a",
    "--reader-callout-border": "#25333d",
    "--reader-callout-title": "#dff6ee",
    "--reader-callout-text": "#dff6ee",
    "--reader-task-done": "#8fa8a4",
    "--reader-checkbox-bg": "#101820",
    "--reader-checkbox-border": "#25333d",
    "--reader-checkbox-checked-bg": "#00e0c6",
    "--reader-checkbox-check-color": "#101820",
    "--reader-mark-bg": "#4d4a1a",
    "--reader-mark-text": "#dff6ee",
    "--reader-tag-bg": "#0d302e",
    "--reader-tag-text": "#00e0c6",
    "--reader-base-00": "#101820",
    "--reader-base-10": "#0c1218",
    "--reader-base-20": "#142027",
    "--reader-base-30": "#25333d",
    "--reader-base-50": "#8fa8a4",
    "--reader-base-70": "#8fa8a4",
    "--reader-base-100": "#dff6ee",
    "--reader-color-red": "#d14d4d",
    "--reader-color-orange": "#d4823b",
    "--reader-color-yellow": "#c29a25",
    "--reader-color-green": "#5f9f67",
    "--reader-color-cyan": "#21a6b8",
    "--reader-color-blue": "#6ee7ff",
    "--reader-color-purple": "#8b6fd1",
    "--reader-color-pink": "#c75b9b",
    "--reader-toolbar-bg": "#0c1218",
    "--reader-control-bg": "#101820",
    "--reader-tree-row-hover": "#0d302e",
    "--reader-tree-row-active": "#0d302e",
    "--reader-outline-active-bg": "#0d302e",
    "--reader-syntax-keyword": "#8b6fd1",
    "--reader-syntax-string": "#5f9f67",
    "--reader-syntax-function": "#6ee7ff",
    "--reader-syntax-comment": "#8fa8a4",
    "--reader-shadow": "0 14px 34px rgba(223, 246, 238, 0.08)"
  },
  "features": [
    "code",
    "tables",
    "file-tree",
    "toolbar",
    "json-yaml"
  ],
  "previewFixtures": [
    "code",
    "json-yaml",
    "file-tree"
  ],
  "css": ".document-reader { font-feature-settings: \"liga\" 1, \"calt\" 1; }\n.document-reader .markdown-heading { font-family: var(--reader-heading-font); color: var(--reader-heading-text); letter-spacing: 0; }\n.document-reader .markdown-heading--h1 { margin-bottom: 0.58em; }\n.document-reader .markdown-heading--h2 { margin-top: 1.35em; }\n.document-reader .markdown-paragraph { margin-bottom: var(--reader-paragraph-spacing); }\n.document-reader .markdown-link { text-decoration-thickness: 1px; text-underline-offset: 0.16em; }\n.document-reader .markdown-inline-code { padding: 0.1em 0.32em; border-radius: var(--reader-code-radius); }\n.document-reader .markdown-code-block { background: var(--reader-code-bg); color: var(--reader-code-text); border-radius: var(--reader-code-radius); }\n.document-reader .markdown-table { color: var(--reader-table-text); }\n.document-reader .markdown-table-cell { padding: var(--reader-table-cell-padding); }\n.document-reader .markdown-table-row:nth-child(even) .markdown-table-cell { background: var(--reader-table-stripe); }\n.document-reader .markdown-quote { background: var(--reader-quote-bg); color: var(--reader-quote-text); }\n.document-reader .callout { background: var(--reader-callout-bg); border-color: var(--reader-callout-border); }\n.document-reader .callout-title { color: var(--reader-callout-title); }\n.document-reader .markdown-tag { border-radius: var(--reader-tag-radius); padding: var(--reader-tag-padding); }\n[data-theme-layout-scope=\"toolbar-group\"] { min-height: var(--reader-toolbar-height); }\n[data-theme-layout-scope=\"outline-indicator\"].is-active { color: var(--reader-link); }\n[data-theme-layout-scope=\"table-actions\"] { color: var(--reader-muted); }\n[data-theme-layout-scope=\"mermaid-actions\"] { color: var(--reader-text); }\n@media (max-width: 700px) { .document-reader .markdown-heading--h1 { font-size: 26px; } }\n.document-reader { font-variant-numeric: tabular-nums; }\n.document-reader .markdown-heading { font-family: var(--reader-heading-font); }\n.document-reader .markdown-code-block { border-left: 3px solid var(--reader-accent); }\n.document-reader .markdown-inline-code { border: 1px solid var(--reader-code-border); }\n[data-theme-layout-scope=\"toolbar-group\"] { gap: 6px; }\n[data-theme-layout-scope=\"toolbar-group\"] button { border-radius: 2px; min-height: 28px; }\n[data-theme-layout-scope=\"file-tree-indicator\"] { border-radius: 2px; }"
}
