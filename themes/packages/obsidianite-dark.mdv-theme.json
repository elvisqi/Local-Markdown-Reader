{
  "id": "obsidianite-dark",
  "name": "Obsidianite Dark",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Obsidianite inspired dark theme with crisp contrast and vivid links.",
  "minAppVersion": "2.3.1",
  "colorScheme": "dark",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.7",
    "--reader-page-bg": "#101218",
    "--reader-surface": "#181b24",
    "--reader-border": "#2b3040",
    "--reader-text": "#e8e9ef",
    "--reader-muted": "#a2a6b3",
    "--reader-link": "#9d8cff",
    "--reader-radius": "8px",
    "--reader-panel-bg": "#131720",
    "--reader-panel-border": "#2b3040",
    "--reader-accent": "#9d8cff",
    "--reader-accent-muted": "#2b2547",
    "--reader-selection-bg": "#403466",
    "--reader-heading-text": "#ffffff",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#34394a",
    "--reader-code-bg": "#202431",
    "--reader-code-text": "#eceef6",
    "--reader-inline-code-bg": "#242839",
    "--reader-inline-code-text": "#d7d1ff",
    "--reader-table-head": "#222837",
    "--reader-table-stripe": "#1c202c",
    "--reader-rule": "#34394a",
    "--reader-quote-bg": "#1d2230",
    "--reader-quote-border": "#9d8cff",
    "--reader-quote-text": "#c8cad4",
    "--reader-task-done": "#828794",
    "--reader-mark-bg": "#5a4a22",
    "--reader-mark-text": "#fff0b8",
    "--reader-tag-bg": "#2b2547",
    "--reader-tag-text": "#c8c0ff",
    "--reader-shadow": "0 20px 46px rgba(0, 0, 0, 0.34)",
    "--reader-font-family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#ffffff",
    "--reader-h1-size": "31px",
    "--reader-h1-weight": "780",
    "--reader-h2-color": "#e8e9ef",
    "--reader-h2-size": "23px",
    "--reader-h2-weight": "740",
    "--reader-h3-color": "#9d8cff",
    "--reader-h3-size": "18px",
    "--reader-h3-weight": "720",
    "--reader-paragraph-spacing": "14px",
    "--reader-list-spacing": "16px",
    "--reader-list-indent": "24px",
    "--reader-table-text": "#e8e9ef",
    "--reader-table-border": "#2b3040",
    "--reader-table-cell-padding": "9px 12px",
    "--reader-table-row-hover": "#202638",
    "--reader-code-radius": "7px",
    "--reader-code-border": "#2b3040",
    "--reader-code-font-size": "0.88em",
    "--reader-quote-padding": "9px 14px",
    "--reader-quote-radius": "6px",
    "--reader-callout-bg": "#1d2230",
    "--reader-callout-border": "#9d8cff",
    "--reader-callout-title": "#c8c0ff",
    "--reader-callout-text": "#c8cad4",
    "--reader-callout-radius": "8px",
    "--reader-checkbox-bg": "#181b24",
    "--reader-checkbox-border": "#565c70",
    "--reader-checkbox-checked-bg": "#9d8cff",
    "--reader-checkbox-check-color": "#101218",
    "--reader-tag-radius": "999px",
    "--reader-tag-padding": "0.07em 0.52em",
    "--reader-base-00": "#101218",
    "--reader-base-10": "#181b24",
    "--reader-base-20": "#202431",
    "--reader-base-30": "#2b3040",
    "--reader-base-50": "#828794",
    "--reader-base-70": "#c8cad4",
    "--reader-base-100": "#ffffff",
    "--reader-color-blue": "#7aa2f7",
    "--reader-color-purple": "#9d8cff",
    "--reader-toolbar-bg": "#131720",
    "--reader-control-bg": "#181b24",
    "--reader-control-radius": "8px",
    "--reader-tree-row-hover": "#202638",
    "--reader-tree-row-active": "#2b2547",
    "--reader-outline-active-bg": "#2b2547",
    "--reader-syntax-keyword": "#9d8cff",
    "--reader-syntax-string": "#9ece6a",
    "--reader-syntax-function": "#7aa2f7",
    "--reader-syntax-comment": "#a2a6b3"
  },
  "css": ".document-reader strong { color: var(--reader-heading-text); } .document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 760; }"
}
