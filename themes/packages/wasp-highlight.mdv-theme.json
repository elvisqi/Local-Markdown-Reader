{
  "id": "wasp-highlight",
  "name": "Wasp Highlight",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Wasp inspired high-energy dark theme with sharp amber accents.",
  "minAppVersion": "2.3.1",
  "colorScheme": "dark",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.7",
    "--reader-page-bg": "#16150f",
    "--reader-surface": "#201f18",
    "--reader-border": "#3d3826",
    "--reader-text": "#f0ead8",
    "--reader-muted": "#b5aa89",
    "--reader-link": "#f2c14d",
    "--reader-radius": "7px",
    "--reader-panel-bg": "#1a1912",
    "--reader-panel-border": "#3d3826",
    "--reader-accent": "#f2c14d",
    "--reader-accent-muted": "#3a3018",
    "--reader-selection-bg": "#55431b",
    "--reader-heading-text": "#ffe08a",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#4b432b",
    "--reader-code-bg": "#29271c",
    "--reader-code-text": "#fff0bd",
    "--reader-inline-code-bg": "#302c1d",
    "--reader-inline-code-text": "#ffe08a",
    "--reader-table-head": "#2d291d",
    "--reader-table-stripe": "#242218",
    "--reader-rule": "#4b432b",
    "--reader-quote-bg": "#292515",
    "--reader-quote-border": "#f2c14d",
    "--reader-quote-text": "#dfd2ad",
    "--reader-task-done": "#8f8566",
    "--reader-mark-bg": "#f2c14d",
    "--reader-mark-text": "#17140b",
    "--reader-tag-bg": "#3a3018",
    "--reader-tag-text": "#ffe08a",
    "--reader-shadow": "0 18px 42px rgba(0, 0, 0, 0.32)"
  },
  "css": ".document-reader mark { font-weight: 650; } .document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 760; }"
}
