{
  "id": "wasp-highlight",
  "name": "Wasp Highlight",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Wasp inspired high-energy dark theme with sharp amber accents.",
  "minAppVersion": "2.3.1",
  "colorScheme": "dark",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.7",
    "--reader-page-bg": "#16150f",
    "--reader-surface": "#201f18",
    "--reader-border": "#3d3826",
    "--reader-text": "#f0ead8",
    "--reader-muted": "#b5aa89",
    "--reader-link": "#f2c14d",
    "--reader-radius": "7px",
    "--reader-panel-bg": "#1a1912",
    "--reader-panel-border": "#3d3826",
    "--reader-accent": "#f2c14d",
    "--reader-accent-muted": "#3a3018",
    "--reader-selection-bg": "#55431b",
    "--reader-heading-text": "#ffe08a",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#4b432b",
    "--reader-code-bg": "#29271c",
    "--reader-code-text": "#fff0bd",
    "--reader-inline-code-bg": "#302c1d",
    "--reader-inline-code-text": "#ffe08a",
    "--reader-table-head": "#2d291d",
    "--reader-table-stripe": "#242218",
    "--reader-rule": "#4b432b",
    "--reader-quote-bg": "#292515",
    "--reader-quote-border": "#f2c14d",
    "--reader-quote-text": "#dfd2ad",
    "--reader-task-done": "#8f8566",
    "--reader-mark-bg": "#f2c14d",
    "--reader-mark-text": "#17140b",
    "--reader-tag-bg": "#3a3018",
    "--reader-tag-text": "#ffe08a",
    "--reader-shadow": "0 18px 42px rgba(0, 0, 0, 0.32)",
    "--reader-font-family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#ffe08a",
    "--reader-h1-size": "30px",
    "--reader-h1-weight": "780",
    "--reader-h2-color": "#f2c14d",
    "--reader-h2-size": "23px",
    "--reader-h2-weight": "740",
    "--reader-h3-color": "#f4cf71",
    "--reader-h3-size": "18px",
    "--reader-h3-weight": "720",
    "--reader-paragraph-spacing": "14px",
    "--reader-list-spacing": "16px",
    "--reader-list-indent": "24px",
    "--reader-table-text": "#f0ead8",
    "--reader-table-border": "#3d3826",
    "--reader-table-cell-padding": "8px 11px",
    "--reader-table-row-hover": "#302b1b",
    "--reader-code-radius": "6px",
    "--reader-code-border": "#3d3826",
    "--reader-code-font-size": "0.88em",
    "--reader-quote-padding": "8px 14px",
    "--reader-quote-radius": "0 7px 7px 0",
    "--reader-callout-bg": "#292515",
    "--reader-callout-border": "#f2c14d",
    "--reader-callout-title": "#ffe08a",
    "--reader-callout-text": "#dfd2ad",
    "--reader-callout-radius": "7px",
    "--reader-checkbox-bg": "#201f18",
    "--reader-checkbox-border": "#6f6234",
    "--reader-checkbox-checked-bg": "#f2c14d",
    "--reader-checkbox-check-color": "#17140b",
    "--reader-tag-radius": "999px",
    "--reader-tag-padding": "0.07em 0.52em",
    "--reader-base-00": "#16150f",
    "--reader-base-10": "#201f18",
    "--reader-base-20": "#29271c",
    "--reader-base-30": "#3d3826",
    "--reader-base-50": "#8f8566",
    "--reader-base-70": "#dfd2ad",
    "--reader-base-100": "#f0ead8",
    "--reader-color-blue": "#7bb2d9",
    "--reader-color-purple": "#b794f4",
    "--reader-toolbar-bg": "#1a1912",
    "--reader-control-bg": "#201f18",
    "--reader-control-radius": "7px",
    "--reader-tree-row-hover": "#302b1b",
    "--reader-tree-row-active": "#3a3018",
    "--reader-outline-active-bg": "#3a3018",
    "--reader-syntax-keyword": "#f2c14d",
    "--reader-syntax-string": "#b4d273",
    "--reader-syntax-function": "#ffcf5c",
    "--reader-syntax-comment": "#b5aa89"
  },
  "css": ".document-reader mark { font-weight: 650; } .document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 760; }"
}
