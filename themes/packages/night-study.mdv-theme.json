{
  "id": "night-study",
  "name": "Night Study",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Dark reading theme with restrained contrast.",
  "minAppVersion": "2.3.1",
  "colorScheme": "dark",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.75",
    "--reader-page-bg": "#0f141b",
    "--reader-surface": "#171f2a",
    "--reader-border": "#2d3a49",
    "--reader-text": "#e6edf5",
    "--reader-muted": "#9aa8b7",
    "--reader-link": "#8ab4ff",
    "--reader-radius": "8px",
    "--reader-panel-bg": "#141d28",
    "--reader-panel-border": "#2d3a49",
    "--reader-accent": "#8ab4ff",
    "--reader-accent-muted": "#172b45",
    "--reader-selection-bg": "#25476f",
    "--reader-heading-text": "#f2f6fb",
    "--reader-heading-font": "inherit",
    "--reader-heading-border": "#354252",
    "--reader-code-bg": "#202b37",
    "--reader-code-text": "#e3eaf2",
    "--reader-inline-code-bg": "#202b38",
    "--reader-inline-code-text": "#dbe7f5",
    "--reader-table-head": "#1f2935",
    "--reader-table-stripe": "#1b2530",
    "--reader-rule": "#354252",
    "--reader-quote-bg": "#182330",
    "--reader-quote-border": "#52657d",
    "--reader-quote-text": "#c2ccd8",
    "--reader-task-done": "#7f8d9d",
    "--reader-mark-bg": "#5f4f1f",
    "--reader-mark-text": "#fff1b8",
    "--reader-tag-bg": "#18314f",
    "--reader-tag-text": "#aad0ff",
    "--reader-shadow": "0 16px 36px rgba(0, 0, 0, 0.28)"
  },
  "css": ".document-reader h1, .document-reader h2, .document-reader h3 { color: var(--reader-text); } .document-reader strong { color: #f2f6fb; }"
}
