{
  "id": "minimal-focus",
  "name": "Minimal Focus",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Minimal inspired neutral theme with very quiet chrome.",
  "minAppVersion": "2.3.1",
  "colorScheme": "system",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.76",
    "--reader-page-bg": "#f5f5f2",
    "--reader-surface": "#ffffff",
    "--reader-border": "#ddddda",
    "--reader-text": "#252725",
    "--reader-muted": "#747772",
    "--reader-link": "#4f6f8c",
    "--reader-radius": "6px",
    "--reader-panel-bg": "#fafafa",
    "--reader-panel-border": "#ddddda",
    "--reader-accent": "#4f6f8c",
    "--reader-accent-muted": "#edf2f5",
    "--reader-selection-bg": "#dce7ee",
    "--reader-heading-text": "#1f211f",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#e2e2de",
    "--reader-code-bg": "#f0f0ed",
    "--reader-code-text": "#303330",
    "--reader-inline-code-bg": "#f0f0ed",
    "--reader-inline-code-text": "#303330",
    "--reader-table-head": "#f3f3ef",
    "--reader-table-stripe": "#fafaf8",
    "--reader-rule": "#e0e0dc",
    "--reader-quote-bg": "#f8f8f5",
    "--reader-quote-border": "#b9bdb6",
    "--reader-quote-text": "#636761",
    "--reader-task-done": "#8a8d86",
    "--reader-mark-bg": "#fff3aa",
    "--reader-mark-text": "#252725",
    "--reader-tag-bg": "#edf2f5",
    "--reader-tag-text": "#4f6f8c",
    "--reader-shadow": "0 8px 26px rgba(37, 39, 37, 0.06)"
  },
  "css": ".document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 650; } .document-reader blockquote { border-radius: 0 6px 6px 0; }"
}
