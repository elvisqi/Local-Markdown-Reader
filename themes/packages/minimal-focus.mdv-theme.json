{
  "id": "minimal-focus",
  "name": "Minimal Focus",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Minimal inspired neutral theme with very quiet chrome.",
  "minAppVersion": "2.3.1",
  "colorScheme": "system",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.76",
    "--reader-page-bg": "#f5f5f2",
    "--reader-surface": "#ffffff",
    "--reader-border": "#ddddda",
    "--reader-text": "#252725",
    "--reader-muted": "#747772",
    "--reader-link": "#4f6f8c",
    "--reader-radius": "6px",
    "--reader-panel-bg": "#fafafa",
    "--reader-panel-border": "#ddddda",
    "--reader-accent": "#4f6f8c",
    "--reader-accent-muted": "#edf2f5",
    "--reader-selection-bg": "#dce7ee",
    "--reader-heading-text": "#1f211f",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#e2e2de",
    "--reader-code-bg": "#f0f0ed",
    "--reader-code-text": "#303330",
    "--reader-inline-code-bg": "#f0f0ed",
    "--reader-inline-code-text": "#303330",
    "--reader-table-head": "#f3f3ef",
    "--reader-table-stripe": "#fafaf8",
    "--reader-rule": "#e0e0dc",
    "--reader-quote-bg": "#f8f8f5",
    "--reader-quote-border": "#b9bdb6",
    "--reader-quote-text": "#636761",
    "--reader-task-done": "#8a8d86",
    "--reader-mark-bg": "#fff3aa",
    "--reader-mark-text": "#252725",
    "--reader-tag-bg": "#edf2f5",
    "--reader-tag-text": "#4f6f8c",
    "--reader-shadow": "0 8px 26px rgba(37, 39, 37, 0.06)",
    "--reader-font-family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#1f211f",
    "--reader-h1-size": "29px",
    "--reader-h1-weight": "650",
    "--reader-h1-line-height": "1.24",
    "--reader-h2-color": "#2f332f",
    "--reader-h2-size": "22px",
    "--reader-h2-weight": "620",
    "--reader-h3-color": "#3a3d38",
    "--reader-h3-size": "18px",
    "--reader-h3-weight": "620",
    "--reader-paragraph-spacing": "12px",
    "--reader-list-spacing": "14px",
    "--reader-list-indent": "22px",
    "--reader-table-text": "#252725",
    "--reader-table-border": "#ddddda",
    "--reader-table-cell-padding": "8px 10px",
    "--reader-table-row-hover": "#f1f3f0",
    "--reader-code-radius": "5px",
    "--reader-code-border": "#ddddda",
    "--reader-code-font-size": "0.86em",
    "--reader-quote-padding": "6px 0 6px 16px",
    "--reader-quote-radius": "0 6px 6px 0",
    "--reader-callout-bg": "#f8f8f5",
    "--reader-callout-border": "#d7d9d4",
    "--reader-callout-title": "#2f332f",
    "--reader-callout-text": "#636761",
    "--reader-callout-radius": "6px",
    "--reader-checkbox-bg": "#ffffff",
    "--reader-checkbox-border": "#b9bdb6",
    "--reader-checkbox-checked-bg": "#4f6f8c",
    "--reader-checkbox-check-color": "#ffffff",
    "--reader-tag-radius": "6px",
    "--reader-tag-padding": "0.04em 0.42em",
    "--reader-base-00": "#ffffff",
    "--reader-base-10": "#fafafa",
    "--reader-base-20": "#f0f0ed",
    "--reader-base-30": "#ddddda",
    "--reader-base-50": "#9da19a",
    "--reader-base-70": "#636761",
    "--reader-base-100": "#252725",
    "--reader-color-blue": "#4f6f8c",
    "--reader-color-purple": "#7a6f9f",
    "--reader-toolbar-bg": "#fafafa",
    "--reader-control-bg": "#ffffff",
    "--reader-control-radius": "6px",
    "--reader-tree-row-hover": "#f1f3f0",
    "--reader-tree-row-active": "#edf2f5",
    "--reader-outline-active-bg": "#edf2f5",
    "--reader-syntax-keyword": "#7a6f9f",
    "--reader-syntax-string": "#5b7d58",
    "--reader-syntax-function": "#4f6f8c",
    "--reader-syntax-comment": "#747772"
  },
  "css": ".document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 650; } .document-reader blockquote { border-radius: 0 6px 6px 0; }"
}
