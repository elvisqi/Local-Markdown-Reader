{
  "id": "ink-focus",
  "name": "Ink Focus",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Neutral contrast for long technical documents.",
  "minAppVersion": "2.3.1",
  "colorScheme": "light",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.72",
    "--reader-page-bg": "#f4f6f8",
    "--reader-surface": "#ffffff",
    "--reader-border": "#d8dee7",
    "--reader-text": "#1f2933",
    "--reader-muted": "#64707d",
    "--reader-link": "#1f5f9f",
    "--reader-radius": "8px",
    "--reader-panel-bg": "#ffffff",
    "--reader-panel-border": "#d8dee7",
    "--reader-accent": "#1f5f9f",
    "--reader-accent-muted": "#e6f0fb",
    "--reader-selection-bg": "#dbeafe",
    "--reader-heading-text": "#1f2933",
    "--reader-heading-font": "inherit",
    "--reader-heading-border": "#d9e0e8",
    "--reader-code-bg": "#edf1f5",
    "--reader-code-text": "#24303c",
    "--reader-inline-code-bg": "#edf1f5",
    "--reader-inline-code-text": "#24303c",
    "--reader-table-head": "#f5f7fa",
    "--reader-table-stripe": "#f8fafc",
    "--reader-rule": "#d9e0e8",
    "--reader-quote-bg": "#f7f9fb",
    "--reader-quote-border": "#9aa8b7",
    "--reader-quote-text": "#53606c",
    "--reader-task-done": "#7b8794",
    "--reader-mark-bg": "#fff4b8",
    "--reader-mark-text": "#1f2933",
    "--reader-tag-bg": "#e6f0fb",
    "--reader-tag-text": "#1f5f9f",
    "--reader-shadow": "0 14px 32px rgba(31, 41, 51, 0.08)"
  },
  "css": ".document-reader h1, .document-reader h2, .document-reader h3 { letter-spacing: 0; } .document-reader table { font-variant-numeric: tabular-nums; }"
}
