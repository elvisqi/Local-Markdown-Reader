{
  "id": "atom-one-reader",
  "name": "Atom One Reader",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Atom One inspired dark theme for code-heavy Markdown notes.",
  "minAppVersion": "2.3.1",
  "colorScheme": "dark",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.72",
    "--reader-page-bg": "#151922",
    "--reader-surface": "#1e2430",
    "--reader-border": "#303847",
    "--reader-text": "#d9dee8",
    "--reader-muted": "#9ba6b6",
    "--reader-link": "#74adea",
    "--reader-radius": "8px",
    "--reader-panel-bg": "#191f2a",
    "--reader-panel-border": "#303847",
    "--reader-accent": "#74adea",
    "--reader-accent-muted": "#1d344e",
    "--reader-selection-bg": "#274763",
    "--reader-heading-text": "#f0f3f8",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#363f50",
    "--reader-code-bg": "#252b37",
    "--reader-code-text": "#dfe6f3",
    "--reader-inline-code-bg": "#262d3a",
    "--reader-inline-code-text": "#d6e7ff",
    "--reader-table-head": "#252d3b",
    "--reader-table-stripe": "#202734",
    "--reader-rule": "#394354",
    "--reader-quote-bg": "#1d2633",
    "--reader-quote-border": "#74adea",
    "--reader-quote-text": "#c3cdda",
    "--reader-task-done": "#7f8a99",
    "--reader-mark-bg": "#51451f",
    "--reader-mark-text": "#ffe9a8",
    "--reader-tag-bg": "#1d344e",
    "--reader-tag-text": "#a9d4ff",
    "--reader-shadow": "0 18px 42px rgba(0, 0, 0, 0.28)",
    "--reader-font-family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#f0f3f8",
    "--reader-h1-size": "30px",
    "--reader-h1-weight": "720",
    "--reader-h2-color": "#dfe6f3",
    "--reader-h2-size": "23px",
    "--reader-h2-weight": "700",
    "--reader-h3-color": "#74adea",
    "--reader-h3-size": "18px",
    "--reader-h3-weight": "680",
    "--reader-paragraph-spacing": "14px",
    "--reader-list-spacing": "16px",
    "--reader-list-indent": "24px",
    "--reader-table-text": "#d9dee8",
    "--reader-table-border": "#303847",
    "--reader-table-cell-padding": "9px 12px",
    "--reader-table-row-hover": "#293244",
    "--reader-code-radius": "8px",
    "--reader-code-border": "#303847",
    "--reader-code-font-size": "0.88em",
    "--reader-quote-padding": "8px 14px",
    "--reader-quote-radius": "8px",
    "--reader-callout-bg": "#1d2633",
    "--reader-callout-border": "#74adea",
    "--reader-callout-title": "#74adea",
    "--reader-callout-text": "#c3cdda",
    "--reader-callout-radius": "8px",
    "--reader-checkbox-bg": "#1e2430",
    "--reader-checkbox-border": "#4d5970",
    "--reader-checkbox-checked-bg": "#74adea",
    "--reader-checkbox-check-color": "#151922",
    "--reader-tag-radius": "6px",
    "--reader-tag-padding": "0.06em 0.5em",
    "--reader-base-00": "#151922",
    "--reader-base-10": "#1e2430",
    "--reader-base-20": "#252b37",
    "--reader-base-30": "#303847",
    "--reader-base-50": "#7f8a99",
    "--reader-base-70": "#c3cdda",
    "--reader-base-100": "#f0f3f8",
    "--reader-color-blue": "#74adea",
    "--reader-color-purple": "#c678dd",
    "--reader-toolbar-bg": "#191f2a",
    "--reader-control-bg": "#1e2430",
    "--reader-control-radius": "8px",
    "--reader-tree-row-hover": "#293244",
    "--reader-tree-row-active": "#1d344e",
    "--reader-outline-active-bg": "#1d344e",
    "--reader-syntax-keyword": "#c678dd",
    "--reader-syntax-string": "#98c379",
    "--reader-syntax-function": "#61afef",
    "--reader-syntax-comment": "#9ba6b6"
  },
  "css": ".document-reader table { font-variant-numeric: tabular-nums; } .document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 720; }"
}
