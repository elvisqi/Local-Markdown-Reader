{
  "id": "things-flow",
  "name": "Things Flow",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Things inspired light theme for task lists and clean daily notes.",
  "minAppVersion": "2.3.1",
  "colorScheme": "light",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.72",
    "--reader-page-bg": "#f7f8fa",
    "--reader-surface": "#ffffff",
    "--reader-border": "#dde3eb",
    "--reader-text": "#202936",
    "--reader-muted": "#6a7584",
    "--reader-link": "#2172d2",
    "--reader-radius": "10px",
    "--reader-panel-bg": "#ffffff",
    "--reader-panel-border": "#dde3eb",
    "--reader-accent": "#2172d2",
    "--reader-accent-muted": "#e5f0ff",
    "--reader-selection-bg": "#d8e9ff",
    "--reader-heading-text": "#1b2430",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#dbe3ee",
    "--reader-code-bg": "#eef3f8",
    "--reader-code-text": "#28384a",
    "--reader-inline-code-bg": "#eef3f8",
    "--reader-inline-code-text": "#1f5f9f",
    "--reader-table-head": "#f2f6fb",
    "--reader-table-stripe": "#f8fafc",
    "--reader-rule": "#dbe3ee",
    "--reader-quote-bg": "#f6f9fc",
    "--reader-quote-border": "#8fb6df",
    "--reader-quote-text": "#566474",
    "--reader-task-done": "#8a93a0",
    "--reader-mark-bg": "#fff0b3",
    "--reader-mark-text": "#202936",
    "--reader-tag-bg": "#e5f0ff",
    "--reader-tag-text": "#2172d2",
    "--reader-shadow": "0 16px 38px rgba(32, 41, 54, 0.08)"
  },
  "css": ".document-reader li + li { margin-top: 6px; } .document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 720; }"
}
