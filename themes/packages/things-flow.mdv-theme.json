{
  "id": "things-flow",
  "name": "Things Flow",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Things inspired light theme for task lists and clean daily notes.",
  "minAppVersion": "2.3.1",
  "colorScheme": "light",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.72",
    "--reader-page-bg": "#f7f8fa",
    "--reader-surface": "#ffffff",
    "--reader-border": "#dde3eb",
    "--reader-text": "#202936",
    "--reader-muted": "#6a7584",
    "--reader-link": "#2172d2",
    "--reader-radius": "10px",
    "--reader-panel-bg": "#ffffff",
    "--reader-panel-border": "#dde3eb",
    "--reader-accent": "#2172d2",
    "--reader-accent-muted": "#e5f0ff",
    "--reader-selection-bg": "#d8e9ff",
    "--reader-heading-text": "#1b2430",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#dbe3ee",
    "--reader-code-bg": "#eef3f8",
    "--reader-code-text": "#28384a",
    "--reader-inline-code-bg": "#eef3f8",
    "--reader-inline-code-text": "#1f5f9f",
    "--reader-table-head": "#f2f6fb",
    "--reader-table-stripe": "#f8fafc",
    "--reader-rule": "#dbe3ee",
    "--reader-quote-bg": "#f6f9fc",
    "--reader-quote-border": "#8fb6df",
    "--reader-quote-text": "#566474",
    "--reader-task-done": "#8a93a0",
    "--reader-mark-bg": "#fff0b3",
    "--reader-mark-text": "#202936",
    "--reader-tag-bg": "#e5f0ff",
    "--reader-tag-text": "#2172d2",
    "--reader-shadow": "0 16px 38px rgba(32, 41, 54, 0.08)",
    "--reader-font-family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#1b2430",
    "--reader-h1-size": "30px",
    "--reader-h1-weight": "760",
    "--reader-h2-color": "#273449",
    "--reader-h2-size": "23px",
    "--reader-h2-weight": "720",
    "--reader-h3-color": "#324052",
    "--reader-h3-size": "18px",
    "--reader-h3-weight": "680",
    "--reader-paragraph-spacing": "13px",
    "--reader-list-spacing": "14px",
    "--reader-list-indent": "24px",
    "--reader-list-item-spacing": "6px",
    "--reader-table-text": "#202936",
    "--reader-table-border": "#d5dfeb",
    "--reader-table-cell-padding": "8px 11px",
    "--reader-table-row-hover": "#edf5ff",
    "--reader-code-radius": "8px",
    "--reader-code-border": "#d5dfeb",
    "--reader-code-font-size": "0.86em",
    "--reader-quote-padding": "8px 12px",
    "--reader-quote-radius": "8px",
    "--reader-callout-bg": "#f6f9fc",
    "--reader-callout-border": "#8fb6df",
    "--reader-callout-title": "#2172d2",
    "--reader-callout-text": "#566474",
    "--reader-callout-radius": "10px",
    "--reader-checkbox-bg": "#ffffff",
    "--reader-checkbox-border": "#9eb8d7",
    "--reader-checkbox-checked-bg": "#2172d2",
    "--reader-checkbox-check-color": "#ffffff",
    "--reader-tag-radius": "8px",
    "--reader-tag-padding": "0.08em 0.5em",
    "--reader-base-00": "#ffffff",
    "--reader-base-10": "#f7f8fa",
    "--reader-base-20": "#eef3f8",
    "--reader-base-30": "#dde3eb",
    "--reader-base-50": "#9ca9ba",
    "--reader-base-70": "#566474",
    "--reader-base-100": "#202936",
    "--reader-color-blue": "#2172d2",
    "--reader-color-purple": "#8b5cf6",
    "--reader-toolbar-bg": "#ffffff",
    "--reader-control-bg": "#ffffff",
    "--reader-control-radius": "8px",
    "--reader-tree-row-hover": "#edf5ff",
    "--reader-tree-row-active": "#e5f0ff",
    "--reader-outline-active-bg": "#e5f0ff",
    "--reader-syntax-keyword": "#8b5cf6",
    "--reader-syntax-string": "#16a34a",
    "--reader-syntax-function": "#2172d2",
    "--reader-syntax-comment": "#6a7584"
  },
  "css": ".document-reader li + li { margin-top: 6px; } .document-reader h1, .document-reader h2, .document-reader h3 { font-weight: 720; }"
}
