{
  "id": "nord-notes",
  "name": "Nord Notes",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Nord inspired cool dark theme for calm technical reading.",
  "minAppVersion": "2.3.1",
  "colorScheme": "dark",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.74",
    "--reader-page-bg": "#242a35",
    "--reader-surface": "#2d3543",
    "--reader-border": "#445063",
    "--reader-text": "#e2e8f0",
    "--reader-muted": "#a7b3c4",
    "--reader-link": "#8dc6df",
    "--reader-radius": "8px",
    "--reader-panel-bg": "#252d39",
    "--reader-panel-border": "#445063",
    "--reader-accent": "#8dc6df",
    "--reader-accent-muted": "#2b4350",
    "--reader-selection-bg": "#395a69",
    "--reader-heading-text": "#edf3f8",
    "--reader-heading-font": "Inter, ui-sans-serif, system-ui, sans-serif",
    "--reader-heading-border": "#4b5668",
    "--reader-code-bg": "#26303d",
    "--reader-code-text": "#d8e2ed",
    "--reader-inline-code-bg": "#26303d",
    "--reader-inline-code-text": "#bfe6f4",
    "--reader-table-head": "#333c4b",
    "--reader-table-stripe": "#293240",
    "--reader-rule": "#4b5668",
    "--reader-quote-bg": "#293544",
    "--reader-quote-border": "#8dc6df",
    "--reader-quote-text": "#c7d2df",
    "--reader-task-done": "#8d99aa",
    "--reader-mark-bg": "#584b2a",
    "--reader-mark-text": "#fff0bd",
    "--reader-tag-bg": "#2b4350",
    "--reader-tag-text": "#bfe6f4",
    "--reader-shadow": "0 18px 42px rgba(0, 0, 0, 0.26)",
    "--reader-font-family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#edf3f8",
    "--reader-h1-size": "30px",
    "--reader-h1-weight": "700",
    "--reader-h2-color": "#d8dee9",
    "--reader-h2-size": "23px",
    "--reader-h2-weight": "680",
    "--reader-h3-color": "#8dc6df",
    "--reader-h3-size": "18px",
    "--reader-h3-weight": "680",
    "--reader-paragraph-spacing": "14px",
    "--reader-list-spacing": "16px",
    "--reader-list-indent": "24px",
    "--reader-table-text": "#e2e8f0",
    "--reader-table-border": "#445063",
    "--reader-table-cell-padding": "9px 12px",
    "--reader-table-row-hover": "#344052",
    "--reader-code-radius": "7px",
    "--reader-code-border": "#445063",
    "--reader-code-font-size": "0.88em",
    "--reader-quote-padding": "8px 14px",
    "--reader-quote-radius": "0 8px 8px 0",
    "--reader-callout-bg": "#293544",
    "--reader-callout-border": "#8dc6df",
    "--reader-callout-title": "#8dc6df",
    "--reader-callout-text": "#c7d2df",
    "--reader-callout-radius": "8px",
    "--reader-checkbox-bg": "#2d3543",
    "--reader-checkbox-border": "#607086",
    "--reader-checkbox-checked-bg": "#8dc6df",
    "--reader-checkbox-check-color": "#242a35",
    "--reader-tag-radius": "999px",
    "--reader-tag-padding": "0.07em 0.52em",
    "--reader-base-00": "#242a35",
    "--reader-base-10": "#2d3543",
    "--reader-base-20": "#333c4b",
    "--reader-base-30": "#445063",
    "--reader-base-50": "#8d99aa",
    "--reader-base-70": "#c7d2df",
    "--reader-base-100": "#edf3f8",
    "--reader-color-blue": "#8dc6df",
    "--reader-color-purple": "#b48ead",
    "--reader-toolbar-bg": "#252d39",
    "--reader-control-bg": "#2d3543",
    "--reader-control-radius": "8px",
    "--reader-tree-row-hover": "#344052",
    "--reader-tree-row-active": "#2b4350",
    "--reader-outline-active-bg": "#2b4350",
    "--reader-syntax-keyword": "#b48ead",
    "--reader-syntax-string": "#a3be8c",
    "--reader-syntax-function": "#88c0d0",
    "--reader-syntax-comment": "#a7b3c4"
  },
  "css": ".document-reader h1, .document-reader h2 { font-weight: 680; } .document-reader hr { height: 2px; }"
}
