{
  "id": "classic-journal",
  "name": "Classic Journal",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Traditional document rhythm with calm contrast for mixed notes.",
  "minAppVersion": "2.3.1",
  "colorScheme": "system",
  "tokens": {
    "--markdown-font-size": "16px",
    "--markdown-line-height": "1.7",
    "--reader-page-bg": "#f3f1ec",
    "--reader-surface": "#fffdf8",
    "--reader-border": "#d8d1c4",
    "--reader-text": "#28251f",
    "--reader-muted": "#746b5f",
    "--reader-link": "#32658a",
    "--reader-code-bg": "#f0ece4",
    "--reader-code-text": "#2d3033",
    "--reader-table-head": "#f1ede5",
    "--reader-table-stripe": "#faf7f0",
    "--reader-rule": "#d5cdbf",
    "--reader-quote-bg": "#f7f3ea",
    "--reader-quote-border": "#a7936f",
    "--reader-quote-text": "#665b4e",
    "--reader-shadow": "0 12px 28px rgba(45, 39, 31, 0.08)"
  },
  "css": ".document-reader h1, .document-reader h2, .document-reader h3 { font-family: Georgia, Times, serif; letter-spacing: 0; } .document-reader table { font-variant-numeric: tabular-nums; }"
}
