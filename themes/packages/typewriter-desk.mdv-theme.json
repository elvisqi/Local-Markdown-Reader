{
  "id": "typewriter-desk",
  "name": "Typewriter Desk",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Typewriter inspired warm writing theme with serif document rhythm.",
  "minAppVersion": "2.3.1",
  "colorScheme": "light",
  "tokens": {
    "--markdown-font-size": "17px",
    "--markdown-line-height": "1.86",
    "--reader-page-bg": "#f3efe6",
    "--reader-surface": "#fffdf7",
    "--reader-border": "#d8d0c3",
    "--reader-text": "#2b2925",
    "--reader-muted": "#756d61",
    "--reader-link": "#6a624f",
    "--reader-radius": "6px",
    "--reader-panel-bg": "#f9f5ec",
    "--reader-panel-border": "#d8d0c3",
    "--reader-accent": "#6a624f",
    "--reader-accent-muted": "#eee8dc",
    "--reader-selection-bg": "#e8deca",
    "--reader-heading-text": "#24221e",
    "--reader-heading-font": "ui-serif, Georgia, \"Times New Roman\", serif",
    "--reader-heading-border": "#d8d0c3",
    "--reader-code-bg": "#efe9dc",
    "--reader-code-text": "#2f2d28",
    "--reader-inline-code-bg": "#efe9dc",
    "--reader-inline-code-text": "#2f2d28",
    "--reader-table-head": "#f2ecdf",
    "--reader-table-stripe": "#fbf7ef",
    "--reader-rule": "#d8d0c3",
    "--reader-quote-bg": "#f8f1e5",
    "--reader-quote-border": "#aa9b7f",
    "--reader-quote-text": "#665d51",
    "--reader-task-done": "#8f877b",
    "--reader-mark-bg": "#fff0a3",
    "--reader-mark-text": "#2b2925",
    "--reader-tag-bg": "#eee8dc",
    "--reader-tag-text": "#6a624f",
    "--reader-shadow": "0 14px 34px rgba(67, 56, 42, 0.08)"
  },
  "css": ".document-reader { font-family: ui-serif, Georgia, \"Times New Roman\", serif; } .document-reader code, .document-reader pre { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }"
}
