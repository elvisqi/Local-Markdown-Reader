{
  "id": "typewriter-desk",
  "name": "Typewriter Desk",
  "version": "1.0.0",
  "author": "Local Markdown Reader",
  "description": "Typewriter inspired warm writing theme with serif document rhythm.",
  "minAppVersion": "2.3.1",
  "colorScheme": "light",
  "tokens": {
    "--markdown-font-size": "17px",
    "--markdown-line-height": "1.86",
    "--reader-page-bg": "#f3efe6",
    "--reader-surface": "#fffdf7",
    "--reader-border": "#d8d0c3",
    "--reader-text": "#2b2925",
    "--reader-muted": "#756d61",
    "--reader-link": "#6a624f",
    "--reader-radius": "6px",
    "--reader-panel-bg": "#f9f5ec",
    "--reader-panel-border": "#d8d0c3",
    "--reader-accent": "#6a624f",
    "--reader-accent-muted": "#eee8dc",
    "--reader-selection-bg": "#e8deca",
    "--reader-heading-text": "#24221e",
    "--reader-heading-font": "ui-serif, Georgia, \"Times New Roman\", serif",
    "--reader-heading-border": "#d8d0c3",
    "--reader-code-bg": "#efe9dc",
    "--reader-code-text": "#2f2d28",
    "--reader-inline-code-bg": "#efe9dc",
    "--reader-inline-code-text": "#2f2d28",
    "--reader-table-head": "#f2ecdf",
    "--reader-table-stripe": "#fbf7ef",
    "--reader-rule": "#d8d0c3",
    "--reader-quote-bg": "#f8f1e5",
    "--reader-quote-border": "#aa9b7f",
    "--reader-quote-text": "#665d51",
    "--reader-task-done": "#8f877b",
    "--reader-mark-bg": "#fff0a3",
    "--reader-mark-text": "#2b2925",
    "--reader-tag-bg": "#eee8dc",
    "--reader-tag-text": "#6a624f",
    "--reader-shadow": "0 14px 34px rgba(67, 56, 42, 0.08)",
    "--reader-font-family": "ui-serif, Georgia, \"Times New Roman\", serif",
    "--reader-monospace-font": "\"SFMono-Regular\", Consolas, \"Liberation Mono\", Menlo, monospace",
    "--reader-font-weight": "400",
    "--reader-h1-color": "#24221e",
    "--reader-h1-size": "32px",
    "--reader-h1-weight": "700",
    "--reader-h2-color": "#3d382f",
    "--reader-h2-size": "24px",
    "--reader-h2-weight": "680",
    "--reader-h3-color": "#4f4638",
    "--reader-h3-size": "19px",
    "--reader-h3-weight": "650",
    "--reader-paragraph-spacing": "18px",
    "--reader-list-spacing": "18px",
    "--reader-list-indent": "28px",
    "--reader-table-text": "#2b2925",
    "--reader-table-border": "#d8d0c3",
    "--reader-table-cell-padding": "10px 12px",
    "--reader-table-row-hover": "#f7efe2",
    "--reader-code-radius": "6px",
    "--reader-code-border": "#d8d0c3",
    "--reader-code-font-size": "0.84em",
    "--reader-quote-padding": "10px 14px",
    "--reader-quote-radius": "0 6px 6px 0",
    "--reader-callout-bg": "#f8f1e5",
    "--reader-callout-border": "#aa9b7f",
    "--reader-callout-title": "#3d382f",
    "--reader-callout-text": "#665d51",
    "--reader-callout-radius": "6px",
    "--reader-checkbox-bg": "#fffdf7",
    "--reader-checkbox-border": "#aa9b7f",
    "--reader-checkbox-checked-bg": "#6a624f",
    "--reader-checkbox-check-color": "#fffdf7",
    "--reader-tag-radius": "4px",
    "--reader-tag-padding": "0.03em 0.45em",
    "--reader-base-00": "#fffdf7",
    "--reader-base-10": "#f9f5ec",
    "--reader-base-20": "#efe9dc",
    "--reader-base-30": "#d8d0c3",
    "--reader-base-50": "#9d927f",
    "--reader-base-70": "#665d51",
    "--reader-base-100": "#2b2925",
    "--reader-color-blue": "#6b7c85",
    "--reader-color-purple": "#7c6f95",
    "--reader-toolbar-bg": "#f9f5ec",
    "--reader-control-bg": "#fffdf7",
    "--reader-control-radius": "6px",
    "--reader-tree-row-hover": "#f7efe2",
    "--reader-tree-row-active": "#eee8dc",
    "--reader-outline-active-bg": "#eee8dc",
    "--reader-syntax-keyword": "#7c6f95",
    "--reader-syntax-string": "#64734c",
    "--reader-syntax-function": "#6b7c85",
    "--reader-syntax-comment": "#756d61"
  },
  "css": ".document-reader { font-family: ui-serif, Georgia, \"Times New Roman\", serif; } .document-reader code, .document-reader pre { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }"
}
